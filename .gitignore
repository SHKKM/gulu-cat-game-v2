# Initial GitHub import. Keep workspace-only material out of the index by default.
/*
!/.gitignore
!/.editorconfig
!/.oxlintrc.json
!/package.json
!/package-lock.json
!/tsconfig*.json
!/vite.config.ts
!/vite.pages.config.ts
!/index.html
!/src/
/src/art-workbench/
!/tests/
/tests/*
!/tests/pages-assets.test.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Public sources for the installed home only. Keep old releases and import
# packages outside the repository. Review changes to this list with the manifest.
!/public/
/public/*
!/public/assets/
/public/assets/*
!/public/assets/game/
/public/assets/game/*
!/public/assets/game/manifest.json
!/public/assets/game/assets/
/public/assets/game/assets/*
